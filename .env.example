# Outstatic CMS relay key — get one from https://outstatic.com
# Required for the /outstatic dashboard to authenticate via GitHub.
OUTSTATIC_API_KEY=

# Resend API key — get one from https://resend.com/api-keys
# Required for the callback form to email submissions to the hospital.
RESEND_API_KEY=

# Optional: verified sender address on a Resend-verified domain.
# Defaults to onboarding@resend.dev (Resend's shared sender) if unset.
CALLBACK_FROM_EMAIL=
